[Unit]
Description=Telegram Username Monitor (read-only)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-/etc/username-monitor/mtproxy.env
ExecStart=__PROJECT_DIR__/.venv/bin/python -m username_monitor run
Restart=on-failure
RestartSec=30
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
