# Telegram developer API credentials from https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# Mandatory FakeTLS MTProxy endpoint for Telegram RPC. In production the
# credential runner supplies these two settings from its public CLI options.
TG_MTPROXY_HOST=
TG_MTPROXY_PORT=
# TG_MTPROXY_SECRET_B64 is never read from this file. Set it only in the
# protected process environment (systemd LoadCredential + credential runner).

# Direct Bot API alerts: set BOT_TOKEN and CHAT_ID together.
# With BOT_PROXY_URL and BOT_PROXY_SECRET, CHAT_ID is required; BOT_TOKEN is not.
BOT_TOKEN=
CHAT_ID=
# Optional alias for existing deployments; if both are set, they must match.
TG_CHAT_ID=
BOT_PROXY_URL=
BOT_PROXY_SECRET=

# Relative paths are resolved from the repository working directory.
SESSION_PATH=data/telegram
DB_PATH=data/monitor.sqlite3
USERNAMES_PATH=usernames.txt

# Conservative defaults. Telegram does not publish a guaranteed safe request rate.
CHECK_DELAY_SECONDS=30
CONFIRM_DELAY_SECONDS=10
# Maximum duration of each username RPC, including the free confirmation request.
CHECK_TIMEOUT_SECONDS=30
CYCLE_PAUSE_SECONDS=600
MAX_PER_CYCLE=20
ALERT_FIRST_FREE=true

# Optional local candidate generation. Off until explicitly enabled.
AUTO_DISCOVERY_ENABLED=false
AUTO_DISCOVERY_PER_CYCLE=1
AUTO_DISCOVERY_DAILY_LIMIT=12
AUTO_DISCOVERY_POOL_SIZE=300
AUTO_DISCOVERY_PROMOTED_FIRST=false
MARKET_DISCOVERY_ENABLED=false
