# Telegram developer API credentials from https://my.telegram.org
TG_API_ID=
TG_API_HASH=

# Optional MTProxy for Telethon: fill all three, or leave all blank.
# Secret: 32 hexadecimal characters, optionally prefixed with dd.
TG_PROXY_HOST=
TG_PROXY_PORT=
TG_PROXY_SECRET=

# Telegram transport: legacy uses the existing TG_PROXY_* settings or direct TCP.
# direct bypasses TG_PROXY_*; faketls reads TG_MTPROXY_SECRET_B64 only from the
# process environment (e.g. root-owned /etc/username-monitor/mtproxy.env).
TG_TRANSPORT=legacy
# TG_MTPROXY_HOST and TG_MTPROXY_PORT may also be set in the protected env.
# Do not put TG_MTPROXY_SECRET_B64 in this file.

# Direct Bot API alerts: set BOT_TOKEN and CHAT_ID together.
# With BOT_PROXY_URL and BOT_PROXY_SECRET, CHAT_ID is required; BOT_TOKEN is not.
BOT_TOKEN=
CHAT_ID=
BOT_PROXY_URL=
BOT_PROXY_SECRET=

# Relative paths are resolved from the repository working directory.
SESSION_PATH=data/telegram
DB_PATH=data/monitor.sqlite3
USERNAMES_PATH=usernames.txt

# Conservative defaults. Telegram does not publish a guaranteed safe request rate.
CHECK_DELAY_SECONDS=30
CONFIRM_DELAY_SECONDS=10
# Maximum duration of each username RPC, including the free confirmation request.
CHECK_TIMEOUT_SECONDS=30
CYCLE_PAUSE_SECONDS=600
MAX_PER_CYCLE=20
ALERT_FIRST_FREE=true
